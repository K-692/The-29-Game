# ==============================================================================
# Indian 29 (Twenty-Nine) Card Game - Environment Configuration
# ==============================================================================

# Supabase Project URL (found under Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (safe for client-side web apps)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Note: The application operates gracefully in standalone / local multiplayer mode
# even if Supabase keys are not set, allowing immediate offline play and bot matches!

