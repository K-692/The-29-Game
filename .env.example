# ==============================================================================
# Indian 29 (Twenty-Nine) Card Game - LAN Server Configuration
# ==============================================================================

# Server HTTP and WebSocket port (defaults to 3000 if unset)
PORT=3000

# The application runs as an authoritative LAN multiplayer server.
# Host a LAN game with:
#   npm run lan:host
# Other players on the same Wi-Fi / Local Area Network join via http://<host-ip>:3000
# Zero external cloud services, zero external databases, 100% private and offline-capable!
